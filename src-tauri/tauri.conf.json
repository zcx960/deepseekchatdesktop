{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Desktop",
  "version": "0.1.0",
  "identifier": "io.github.deepseekchatdesktop.desktop",
  "build": {
    "frontendDist": "https://chat.deepseek.com",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek",
        "url": "https://chat.deepseek.com",
        "create": false,
        "width": 1180,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "轻量 DeepSeek 网页桌面客户端",
    "longDescription": "An independent, lightweight Tauri wrapper for the official DeepSeek chat website. Not affiliated with DeepSeek.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
